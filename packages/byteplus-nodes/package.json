{
  "name": "@nodetool-ai/byteplus-nodes",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "version": "0.7.0-rc.34",
  "description": "BytePlus ModelArk Seedance video nodes — bills against your ModelArk API key (resource packs and balance)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/build-typescript-workspace.mjs && node -e \"require('node:fs').cpSync('src/byteplus-manifest.json', 'dist/byteplus-manifest.json')\"",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@nodetool-ai/config": "*",
    "@nodetool-ai/node-sdk": "*",
    "@nodetool-ai/runtime": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./byteplus-manifest.json": "./dist/byteplus-manifest.json"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "nodetool",
    "byteplus",
    "modelark",
    "seedance",
    "video-generation"
  ]
}
